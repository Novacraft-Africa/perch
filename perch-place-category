#!/usr/bin/env python3
# perch place category — group ALL open Terminal server windows by project TYPE
# (metro/landing/web/admin/backend) onto their mapped portrait desktops per
# ~/.config/perch/spaces.conf, INCLUDING unregistered "stray" terminals (categorized
# by their marker pattern, the same way perch's categorize() does). Each target
# desktop is tiled full-width, equal-height, stacked. The working desktop (portrait
# desktop 1) and non-server terminals (plain shells) are left alone.
#   perch-place-category            move + tile
#   perch-place-category dry        print the grouping, move nothing
#   perch-place-category notile     move only, don't retile
import subprocess, json, os, re, collections, sys, time

HOME = os.path.expanduser("~")
SPACES = os.environ.get("PERCH_SPACES", HOME + "/.config/perch/spaces.conf")
PROJECTS = os.environ.get("PERCH_PROJECTS", HOME + "/.config/perch/projects.conf")
DRY = "dry" in sys.argv or "--dry" in sys.argv
NOTILE = "notile" in sys.argv or "--no-tile" in sys.argv

def y(*a): subprocess.run(["yabai", "-m", *a], capture_output=True)
def q(*a): return json.loads(subprocess.check_output(["yabai", "-m", "query", *a]))

def terminal_titles():
    # yabai often reports Terminal AXTitle as "" — read the authoritative custom
    # titles straight from Terminal, keyed by window id (== yabai window id).
    scr = ('tell application "Terminal"\n'
           'set out to ""\n'
           'repeat with w in windows\n'
           'set t to ""\n'
           'try\n set t to custom title of w\n end try\n'
           'if t is "" then\n try\n set t to name of w\n end try\n end if\n'
           'set out to out & (id of w as string) & ":::" & t & linefeed\n'
           'end repeat\n'
           'return out\n'
           'end tell')
    try:
        raw = subprocess.check_output(["osascript", "-e", scr], text=True)
    except Exception:
        return {}
    out = {}
    for line in raw.splitlines():
        if ":::" not in line:
            continue
        wid, title = line.split(":::", 1)
        try:
            out[int(wid)] = title.strip()
        except ValueError:
            pass
    return out

# ---- config: category defaults + per-marker overrides ----
overrides, defaults = {}, {}
CATS = ("metro", "landing", "web", "admin", "backend", "other", "devices")
DEVICE_APPS = ("Simulator", "qemu-system-aarch64", "Android Emulator")
try:
    for line in open(SPACES):
        line = line.strip()
        if not line or line.startswith("#") or "|" not in line:
            continue
        name, spec = line.split("|", 1)
        name, spec = name.strip(), spec.strip().replace(" ", "")
        (defaults if name in CATS else overrides)[name] = spec
except FileNotFoundError:
    pass

ports = {}
try:
    for line in open(PROJECTS):
        line = line.strip()
        if not line or line.startswith("#") or "|" not in line:
            continue
        p = line.split("|")
        ports[p[0].strip()] = (p[1].strip() if len(p) > 1 else "-")
except FileNotFoundError:
    pass

STRONG = re.compile(r"metro|admin|backend|landing|portfolio|website|dashboard|web|-api$")

def categorize(marker):
    lc = marker.lower()
    if "metro" in lc: return "metro"
    if "admin" in lc: return "admin"
    if "backend" in lc or lc.endswith("-api"): return "backend"
    p = ports.get(marker, "")
    if p in ("8000", "8001", "8080"): return "backend"
    if p in ("8082", "8083", "8084", "8085", "8086", "8087", "8088", "8089", "8090", "8091"): return "metro"
    if "landing" in lc or "portfolio" in lc or "website" in lc: return "landing"
    if p == "-": return "other"
    return "web"

def is_server(marker):
    return marker in ports or bool(STRONG.search(marker.lower()))

def marker_of(title):
    parts = [re.sub(r"\s*-\s*port:\d+\s*$", "", s.strip()) for s in title.split(" — ")]
    for p in parts:                                   # 1. a segment that is a registered marker
        if p in ports:
            return p
    for p in parts:                                   # 2. a segment that looks like a server marker
        if " " not in p and len(p) <= 40 and STRONG.search(p.lower()):
            return p
    return parts[1] if len(parts) >= 2 else (parts[0] if parts else "")

disps = q("--displays"); spaces = q("--spaces"); wins = q("--windows")
portrait = [d for d in disps if d["frame"]["h"] > d["frame"]["w"]]
if not portrait:
    print("perch place category: no portrait display found"); raise SystemExit(0)
pdisp = portrait[0]["index"]

def desks(display):
    return sorted([s for s in spaces if s["display"] == display and not s.get("is-native-fullscreen")],
                  key=lambda s: s["index"])

def resolve(spec):
    if ":" in spec:
        d, ordn = spec.split(":"); ordn = int(ordn); od = desks(int(d))
        return od[ordn - 1]["index"] if 1 <= ordn <= len(od) else None
    try:
        return int(spec)
    except ValueError:
        return None

disp_by_space = {s["index"]: s["display"] for s in spaces}
frame_by_disp = {d["index"]: d["frame"] for d in disps}
# desktop -> its intended category (from the category defaults, for labelling)
label_of_sp = {}
for cat, spec in defaults.items():
    sp = resolve(spec)
    if sp:
        label_of_sp[sp] = cat

titles = terminal_titles()
assign = collections.defaultdict(list)
for w in wins:
    if w.get("app") != "Terminal":
        continue
    title = titles.get(w["id"]) or (w.get("title") or "").strip()
    if not title:
        continue
    marker = marker_of(title)
    known = is_server(marker) or " - port:" in title
    cat = categorize(marker) if known else "other"
    spec = overrides.get(marker) or defaults.get(cat)
    if not spec:
        continue
    sp = resolve(spec)
    if not sp:
        continue
    assign[sp].append((w, marker, cat))

dev_sp = resolve(defaults.get("devices") or "")
fs_spaces = {s["index"] for s in spaces if s.get("is-native-fullscreen")}
devices = [w for w in wins if w.get("app") in DEVICE_APPS
           and w.get("space") not in fs_spaces and not w.get("is-minimized")] if dev_sp else []
if devices:
    label_of_sp.setdefault(dev_sp, "devices")

if not assign and not devices:
    print("perch place category: no server terminals to place"); raise SystemExit(0)

for sp in sorted(assign):
    items = assign[sp]
    print(f"  desktop space {sp} [{label_of_sp.get(sp, '?')}]: " + ", ".join(m for _, m, _ in items))
if devices:
    print(f"  desktop space {dev_sp} [devices]: " + ", ".join(w.get("title") or w["app"] for w in devices))

if DRY:
    print("perch place category: DRY RUN — nothing moved")
    raise SystemExit(0)

# move — count failures; yabai "could not locate the window" == stale window tracking
fails = 0
for sp, items in assign.items():
    for w, _, _ in items:
        if w["space"] != sp:
            r = subprocess.run(["yabai", "-m", "window", str(w["id"]), "--space", str(sp)],
                               capture_output=True, text=True)
            if r.returncode != 0:
                fails += 1
for w in devices:
    if w["space"] != dev_sp:
        if subprocess.run(["yabai", "-m", "window", str(w["id"]), "--space", str(dev_sp)],
                          capture_output=True).returncode != 0:
            fails += 1

# self-heal: stale yabai tracking silently drops moves and resizes, even when nothing
# needs moving. Restart yabai once and re-exec a fresh pass. Guards: PERCH_PLACE_HEALED
# (no 2nd heal in the retried run) + a 90s lock (a yabai restart itself fires
# display_changed → autoplace, so bound the restart rate).
HEAL_LOCK = "/tmp/perch-place-heal.lock"
def heal(fails, what):
    recent = os.path.exists(HEAL_LOCK) and (time.time() - os.path.getmtime(HEAL_LOCK) < 90)
    if not fails or "PERCH_PLACE_HEALED" in os.environ or recent:
        return
    print(f"perch place category: {fails} {what}(s) failed (stale yabai tracking) — restarting yabai + retrying")
    open(HEAL_LOCK, "w").close()
    subprocess.run(["yabai", "--restart-service"], capture_output=True)
    for _ in range(6):
        time.sleep(2)
        if subprocess.run(["yabai", "-m", "query", "--displays"], capture_output=True).returncode == 0:
            break
    os.execve(sys.executable, [sys.executable] + sys.argv, dict(os.environ, PERCH_PLACE_HEALED="1"))

heal(fails, "move")

# tile each desktop full-width, stacked. Re-query the ACTUAL windows now on each target
# space — tiling the pre-move `assign` (a window that failed to move, or a stale count)
# is what left gaps/overlaps = "not filling". Sizing from reality fills the desktop.
if not NOTILE:
    TOP, GAP = 32, 8
    MAX_DEVICE_OVERLAP = 0.35
    DEVICE_GAP = 4
    fresh = q("--windows")
    targets = set(assign) | ({dev_sp} if devices else set())
    persp = collections.defaultdict(list)
    devsp = collections.defaultdict(list)
    tile_fails = 0
    for w in fresh:
        if w.get("space") not in targets:
            continue
        if w.get("app") == "Terminal":
            persp[w["space"]].append(w)
        elif w.get("app") in DEVICE_APPS and not w.get("is-minimized") and w["frame"]["h"] >= 100:
            devsp[w["space"]].append(w)

    def place(wid, op, arg):
        global tile_fails
        if subprocess.run(["yabai", "-m", "window", str(wid), op, arg],
                          capture_output=True).returncode != 0:
            tile_fails += 1

    # An Android emulator is a main window plus a separate toolbar window from the same
    # process; they move as one unit so the toolbar stays beside its emulator.
    def device_units(devs):
        grouped = collections.defaultdict(list)
        for w in devs:
            key = (w["app"], w["id"]) if w["app"] == "Simulator" else (w["app"], w.get("pid"))
            grouped[key].append(w)
        units = [sorted(members, key=lambda m: -m["frame"]["w"] * m["frame"]["h"]) for members in grouped.values()]
        return sorted(units, key=lambda unit: (unit[0]["app"] != "Simulator", unit[0]["id"]))

    def unit_width(unit):
        return sum(m["frame"]["w"] for m in unit) + DEVICE_GAP * (len(unit) - 1)

    reserved = {}
    for sp, devs in devsp.items():
        f = frame_by_disp[disp_by_space[sp]]
        FX, FY, FW, FH = f["x"], f["y"], f["w"], f["h"]
        units = device_units(devs)
        usable = FW - 2 * DEVICE_GAP
        total = sum(unit_width(unit) for unit in units) + DEVICE_GAP * (len(units) - 1)
        overflow = total - usable
        smallest = min(unit_width(unit) for unit in units)
        if overflow <= 0 or (len(units) > 1 and overflow <= MAX_DEVICE_OVERLAP * smallest):
            rows = [units]
            step_cut = max(0, overflow) / max(1, len(units) - 1)
        else:
            rows, row, width = [], [], 0
            for unit in units:
                uw = unit_width(unit)
                if row and width + DEVICE_GAP + uw > usable:
                    rows.append(row); row, width = [], 0
                row.append(unit); width += (DEVICE_GAP if width else 0) + uw
            if row:
                rows.append(row)
            step_cut = 0
        bottom = FY + FH - DEVICE_GAP
        for row in rows:
            rh = max(m["frame"]["h"] for unit in row for m in unit)
            x = FX + DEVICE_GAP
            for unit in row:
                unit_top = bottom - unit[0]["frame"]["h"]
                for m in unit:
                    place(m["id"], "--move", f"abs:{int(x)}:{int(unit_top)}")
                    x += m["frame"]["w"] + DEVICE_GAP
                x -= step_cut
            bottom -= rh + DEVICE_GAP
        reserved[sp] = FY + FH - DEVICE_GAP - bottom

    for sp, items in sorted(persp.items()):
        f = frame_by_disp[disp_by_space[sp]]
        FX, FY, FW, FH = f["x"], f["y"], f["w"], f["h"]
        FH -= reserved.get(sp, 0)
        n = len(items); ah = (FH - TOP - GAP) / n
        for i, w in enumerate(sorted(items, key=lambda x: x["id"])):
            place(w["id"], "--move", f"abs:{int(FX+GAP)}:{int(FY+TOP+i*ah)}")
            place(w["id"], "--resize", f"abs:{int(FW-2*GAP)}:{int(ah-GAP)}")
    heal(tile_fails, "tile")

total = sum(len(v) for v in assign.values())
print(f"perch place category: grouped {total} terminals by type across {len(assign)} desktop(s)"
      + (f", {len(devices)} simulator/emulator window(s) on space {dev_sp}" if devices else ""))
